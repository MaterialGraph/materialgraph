# Install as /etc/materialgraph/backup.env with root:root ownership and mode 0600.
# Use the real private bucket name only in the installed, untracked file.
MATERIALGRAPH_BACKUP_BUCKET=replace-with-private-backup-bucket
MATERIALGRAPH_BACKUP_REGION=ap-south-1
MATERIALGRAPH_BACKUP_PREFIX=production
# Use the dedicated SQL-created read-only backup role. Never commit the real URL.
MATERIALGRAPH_BACKUP_DATABASE_URL=replace-with-dedicated-backup-role-url
